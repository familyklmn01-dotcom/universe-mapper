rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function universe(id) { return get(/databases/$(database)/documents/universes/$(id)).data; }
    function owner(data) { return signedIn() && data.ownerId == request.auth.uid; }
    function member(data) { return signedIn() && request.auth.uid in data.memberIds; }
    function editor(data) { return member(data) && data.roles[request.auth.uid] == 'Editor'; }
    function invited(data) {
      return signedIn()
        && request.auth.token.email in data.invitedEmails
        && data.inviteExpiry[request.auth.token.email] > request.time.toMillis();
    }

    match /users/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /universes/{universeId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.roles[request.auth.uid] == 'Owner';
      allow read: if owner(resource.data) || member(resource.data) || invited(resource.data);
      allow update: if owner(resource.data) || (
        editor(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.roles == resource.data.roles
      ) || (
        invited(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'roles', 'invitedEmails', 'inviteRoles', 'inviteExpiry', 'updatedAt'])
        && (
          (request.auth.uid in request.resource.data.memberIds
            && request.resource.data.roles[request.auth.uid] == resource.data.inviteRoles[request.auth.token.email])
          || (request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.roles == resource.data.roles)
        )
        && !(request.auth.token.email in request.resource.data.invitedEmails)
      );
      allow delete: if owner(resource.data);

      match /members/{uid} {
        allow read: if owner(universe(universeId)) || member(universe(universeId));
        allow create: if owner(universe(universeId)) || (signedIn() && uid == request.auth.uid && member(universe(universeId)));
        allow update, delete: if owner(universe(universeId));
      }

      match /invitations/{inviteId} {
        allow create, update, delete: if owner(universe(universeId));
        allow read: if owner(universe(universeId)) || (
          signedIn() && resource.data.email == request.auth.token.email
        );
      }

      match /presentations/{presentationId} {
        allow read: if owner(universe(universeId)) || member(universe(universeId));
        allow create, update, delete: if owner(universe(universeId)) || editor(universe(universeId));

        match /scenes/{sceneId} {
          allow read: if owner(universe(universeId)) || member(universe(universeId));
          allow create, update, delete: if owner(universe(universeId)) || editor(universe(universeId));
        }
      }
    }
  }
}
